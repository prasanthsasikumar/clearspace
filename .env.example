# Copy to .env.local and fill in.

# Google Gemini — powers object detection, photo quality, identification.
# Leave unset to run the app in demo mode against recorded fixtures.
GEMINI_API_KEY=

# Model used for vision calls. The default alias tracks the current flash
# model; pinned versions (e.g. gemini-3.5-flash) are faster and cheaper but
# eventually 404 for new keys.
GEMINI_MODEL=gemini-flash-latest

# Where photos live. "disk" writes to ./storage (local only — a serverless
# filesystem is ephemeral, so hosted deployments must use supabase).
BLOB_DRIVER=disk
BLOB_DIR=./storage

# BLOB_DRIVER=supabase
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=            # Settings > API > service_role (secret)
# SUPABASE_BUCKET=sorta

# Database. Omit DATABASE_URL to use embedded PGlite at ./.data/pgdata.
#
# For Supabase use the TRANSACTION POOLER string (port 6543), not the direct
# connection — serverless functions open a connection per invocation and will
# exhaust the direct limit. Run migrations against the SESSION pooler (5432).
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
PGLITE_DIR=./.data/pgdata
