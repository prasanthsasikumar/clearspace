# Copy to .env.local and fill in.

# Google Gemini — powers object detection, photo quality, identification.
# Leave unset to run the app in demo mode against recorded fixtures.
GEMINI_API_KEY=

# Model used for vision calls.
GEMINI_MODEL=gemini-2.5-flash

# Where blobs live. "disk" writes to ./storage.
BLOB_DRIVER=disk
BLOB_DIR=./storage

# Database. Omit DATABASE_URL to use embedded PGlite at ./.data/pgdata.
# Set it to a Postgres connection string to point at Neon/Supabase instead.
# DATABASE_URL=postgres://user:pass@host/db
PGLITE_DIR=./.data/pgdata
